{
 "architecture": {
  "purpose": "Reward useful progress and trusted contribution without encouraging spam, unsafe competition or pay-to-win behaviour.",
  "components": [
   [
    "Lifetime CP",
    "All valid points ever earned",
    "A verified action clears",
    "Only for reversal, fraud or correction"
   ],
   [
    "Available CP",
    "Unspent, unexpired redemption balance",
    "Points earn, redeem, expire or reverse",
    "Yes"
   ],
   [
    "Level",
    "Long-term recognition band",
    "Lifetime CP crosses a threshold",
    "Only if invalid points reverse"
   ],
   [
    "Badge",
    "Evidence of a specific verified achievement",
    "Badge criteria are completed",
    "Yes, if the evidence is invalidated"
   ],
   [
    "Streak",
    "Consistency over a defined period",
    "Qualified activity occurs in consecutive periods",
    "Resets without penalty"
   ],
   [
    "Reputation",
    "Quality and trust indicator",
    "Ratings, acceptance, safety and reliability change",
    "Yes; not redeemable"
   ]
  ],
  "multipliers": [
   [
    "0.00",
    "Rejected, duplicate, unsafe, copied or incomplete",
    "No points; pending points reverse"
   ],
   [
    "0.50",
    "Partially accepted or late, where the rule permits",
    "Half base points"
   ],
   [
    "1.00",
    "Completed and verified to standard",
    "Base points"
   ],
   [
    "1.25",
    "Exceptional quality under a published rubric",
    "25% bonus within cap"
   ]
  ],
  "principles": [
   "Points follow learning: completion and reflection matter more than purchase or registration.",
   "Quality beats volume: CGC and content points are capped and moderated.",
   "No hidden trade: CP cannot be sold, gifted, pooled between households or withdrawn.",
   "No academic distortion: assessment answers, career choices and contest judging never change to increase points.",
   "No minor monetisation: student and parent activity stays in the benefits ledger.",
   "Explain every change: the user can open a points line to see action, date, rule version and status."
  ],
  "formula": "Career Points awarded  min(activity cap, base points x verified quantity x quality multiplier + approved bonus) - reversals. A pending event shows estimated points but does not change the available balance."
 },
